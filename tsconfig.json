{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "lib": [
            "ES2022",
            "DOM"
        ],
        "types": [
            "node"
        ],
        "rootDir": ".",
        "outDir": "dist-test"
    },
    "include": [
        "tests/**/*.ts",
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist-test"
    ]
}